# =================================================================
# PRIME LEARNING - ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# 1. Firebase (Client Authentication & Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 2. Supabase (Database, Realtime & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only key for administrative actions (bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Payment Gateway (Razorpay - India UPI / QR / Cards / NetBanking)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# 4. AI & Intelligent Doubt Solver (Gemini / OpenAI API)
# Powers 24/7 instant step-by-step doubt assistance and AI practice quiz generation
NEXT_PUBLIC_GEMINI_API_KEY=your_google_gemini_api_key

# 5. Email Notifications (Resend / SendGrid)
# For automated fee receipts, admission confirmations & report cards
RESEND_API_KEY=re_your_api_key
EMAIL_FROM_ADDRESS="Prime Learning <admissions@primelearning.edu.in>"
ADMIN_ALERT_EMAIL="director@primelearning.edu.in"

# 6. WhatsApp & SMS Business Alerts (Twilio or Meta WhatsApp Cloud API)
# For automated absence alerts, test mark releases & fee reminders
WHATSAPP_API_TOKEN=your_meta_graph_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# 7. App URLs & Analytics
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
